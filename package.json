{
  "name": "airbridge",
  "productName": "AirBridge",
  "version": "0.1.0",
  "description": "Free, open-source AirPlay screen-mirroring receiver and phone-to-PC file drop for Windows.",
  "main": "src/main.js",
  "license": "GPL-3.0-or-later",
  "author": "alcxandros",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:uxplay": "powershell -ExecutionPolicy Bypass -File scripts/build-uxplay.ps1",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.alcxandros.airbridge",
    "productName": "AirBridge",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/uxplay",
        "to": "uxplay",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "include": "build/installer.nsh"
    }
  }
}
